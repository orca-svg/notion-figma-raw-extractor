{
  "name": "mcp-trace-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:plugin && tsc -b && npm run typecheck:broker && vite build",
    "build:plugin": "tsc -p plugins/figma-trace/tsconfig.json && node scripts/copy-plugin-ui.mjs",
    "package:pilot": "npm run build:plugin && tsx scripts/package-pilot.ts",
    "start": "node scripts/start-prod.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && npm run typecheck:broker",
    "typecheck:broker": "npm --prefix oauth-broker run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^6.1.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.119.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  }
}
